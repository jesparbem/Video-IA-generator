# Copia este fichero a .env (npm run init lo hace por ti). .env está en .gitignore: nunca se sube.
# Aquí solo van secretos y ajustes de máquina. Todo lo demás está en project.config.json.
# Con la voz por defecto (Edge TTS) no hace falta ninguna clave.

# ── ElevenLabs (solo si tts.engine = "elevenlabs") ───────────────────────────
ELEVENLABS_API_KEY=
# Opcional: sobrescribe tts.elevenlabs.voiceId / model de la config en esta máquina
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# ── Edge TTS (opcional: sobrescribe tts.edge.* de la config) ─────────────────
EDGE_VOICE=
EDGE_RATE=

# ── Kokoro local (opcional) ──────────────────────────────────────────────────
KOKORO_MODELS=
KOKORO_VOICE=
KOKORO_LANG=

# ── Render (opcional) ────────────────────────────────────────────────────────
# msedge | chrome: usa un navegador instalado si Playwright no puede descargar Chromium
PW_CHANNEL=
